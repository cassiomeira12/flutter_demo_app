#!/bin/sh
#
# pre-commit hook
# Runs `dart analyze` and `dart fix --dry-run` to ensure code quality.
# Skip with: SKIP_ANALYZE=1 git commit ...
#

if [ "$SKIP_ANALYZE" = "1" ]; then
  exit 0
fi

echo ""
echo "Running dart analyze..."
echo ""

dart analyze
exit_code=$?

if [ $exit_code -ne 0 ]; then
  echo ""
  echo "ERROR: Dart analysis failed. Fix the issues above before committing."
  echo "  To skip (not recommended): SKIP_ANALYZE=1 git commit ..."
  echo ""
  exit 1
fi

echo "Analyze passed."
echo ""
echo "Running dart fix --dry-run..."
echo ""

dart_fix_output=$(dart fix --dry-run 2>&1)
exit_code=$?

if [ $exit_code -ne 0 ]; then
  echo ""
  echo "ERROR: dart fix --dry-run failed to run."
  echo "$dart_fix_output"
  echo ""
  exit 1
fi

if echo "$dart_fix_output" | grep -qE "^[0-9]+ error"; then
  echo ""
  echo "ERROR: dart fix found issues that need to be fixed."
  echo ""
  echo "$dart_fix_output"
  echo ""
  echo "  Run 'dart fix --apply' to apply fixes automatically, then stage and commit again."
  echo "  To skip (not recommended): SKIP_ANALYZE=1 git commit ..."
  echo ""
  exit 1
fi

echo "dart fix passed (no issues found)."
echo ""
exit 0
